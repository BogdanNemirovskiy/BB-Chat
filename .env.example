# Copy this file to ".env" and fill in your own values.
# CRA only exposes variables prefixed with REACT_APP_ to the app.

# Firebase web config (Project settings > General > Your apps)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Cloudinary (Dashboard > Product Environment for cloud name;
# Settings > Upload > Upload presets for an unsigned preset)
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=

# Public "Try Demo" account (intentionally public — baked into the client bundle)
REACT_APP_DEMO_EMAIL=
REACT_APP_DEMO_PASSWORD=

# Seeded conversation partner, used by `npm run seed:demo` only.
# No REACT_APP_ prefix so it never reaches the frontend bundle.
DEMO_FRIEND_EMAIL=
DEMO_FRIEND_PASSWORD=
