rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: any signed-in user can read (needed for user search and for
    // showing other people's avatars/names in the chat list); only the owner
    // may write their own document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Chats: only the participants listed in userIds may read or modify.
    match /chats/{chatId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.userIds;

      // Messages: readable by chat participants; a user may only create a
      // message as themselves (senderId must equal their own uid).
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/chats/$(chatId)).data.userIds;
        allow create: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/chats/$(chatId)).data.userIds
          && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
